# ============================================================================
# Plantilla de variables de entorno. Copia este archivo a `.env` y completa
# los valores reales. NO subas el `.env` real al repositorio.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux/macOS:         cp .env.example .env
# ============================================================================

# Credenciales de Meta (WhatsApp Cloud API).
# Se obtienen en https://developers.facebook.com -> tu app -> WhatsApp.
META_JWT_TOKEN=tu_token_de_acceso_de_meta
META_NUMBER_ID=tu_phone_number_id
META_VERIFY_TOKEN=tu_verify_token
META_VERSION=v25.0

# Puerto del servidor HTTP del bot.
PORT=3008

# Base de datos PostgreSQL compartida con el portal.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/paula?schema=public"

# Intervalo de polling (ms) de la cola de mensajes salientes del portal.
OUTBOUND_POLL_MS=3000

# Antiguedad maxima (segundos) de un mensaje entrante para procesarlo. Meta
# reintrega webhooks pendientes tras una caida/reinicio del bot; un mensaje
# viejo reentregado no debe relanzar el flujo (menu/autenticacion) sin que el
# usuario escriba algo nuevo. Los mensajes mas viejos que esto se ignoran.
# 0 desactiva el filtro. Default 120.
INBOUND_MAX_AGE_SECONDS=120

# ============================================================================
# TLS / inspección SSL (Acronis, proxys corporativos que interceptan HTTPS).
# Node lee esta variable AL ARRANCAR y añade el CA a la cadena de confianza
# tanto de `https` (axios / provider de Meta) como de `fetch` (undici), que es
# lo que usan las llamadas a PhariTech (owner, extracto, retenciones, getStatus).
# Si NO se define en entornos con inspección SSL, `fetch` falla con
# SELF_SIGNED_CERT_IN_CHAIN y el bot responde "No pudimos generar el documento"
# aunque el PDF sí se genere en el proveedor.
# Ruta relativa a la cwd del proceso (paula-bot). Déjala así o apúntala al CA
# de tu entorno. En máquinas sin inspección SSL puedes dejarla comentada.
# ============================================================================
NODE_EXTRA_CA_CERTS=./certs/acronis-ca.pem

# ============================================================================
# AGENTE IA (Amazon Bedrock AgentCore vía la API orquestadora - Lambda).
# Al elegir "hablar con agente", el bot responde con la IA de esta API y, en
# paralelo, el asesor recibe la notificacion de monitoreo en el portal. El bot
# NO usa credenciales de AWS: toda la logica de Bedrock vive en la Lambda.
# ============================================================================

# Endpoint HTTP del agente (POST con { message, sessionId }).
AGENT_API_URL=https://e4vbnziokk.execute-api.us-east-2.amazonaws.com/Prod/chat

# Timeout (ms) de la llamada del bot a la API del agente. La Lambda limita a 180s.
AGENT_API_TIMEOUT_MS=150000

# Vida (ms) del hilo de conversacion con el agente (bedrockSessionId). Por
# defecto 10 min, alineado con el cierre de sesion por inactividad.
AGENT_SESSION_TTL_MS=600000

# Nombre generico del documento cuando el agente devuelve un PDF.
AGENT_PDF_FILENAME=Documento.pdf
